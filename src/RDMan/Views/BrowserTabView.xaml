<UserControl x:Class="RDMan.Views.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RDMan.Infrastructure"
             xmlns:vm="clr-namespace:RDMan.ViewModels"
             xmlns:v="clr-namespace:RDMan.Views"
             Background="{DynamicResource Bg.Content}">
    <UserControl.Resources>
        <!-- ───── Column header ───── -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" Padding="10,0,6,0" Height="32" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <Border x:Name="L" Width="1" Margin="0,9" Background="{DynamicResource Line}" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ───── Rows ───── -->
        <Style x:Key="FileRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="{DynamicResource Row.Height}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="6,0" BorderThickness="1" BorderBrush="Transparent">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center" Margin="-1,0,0,0">
                                <GridViewRowPresenter.Opacity>
                                    <MultiBinding Converter="{StaticResource ItemOpacity}">
                                        <Binding Path="IsCut" />
                                        <Binding Path="IsHidden" />
                                    </MultiBinding>
                                </GridViewRowPresenter.Opacity>
                            </GridViewRowPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.SelectedInactive}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}" />
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- ───── Toolbar breadcrumb ───── -->
        <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="ui:Ui.CornerRadius" Value="5" />
        </Style>

        <!-- ───── Server cards (dashboard) ───── -->
        <!-- Card surface: content stretches to the full card (Btn.Base centers it), the outline firms up on hover. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
            <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Overlay" Background="Transparent" CornerRadius="7" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Bg.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same identity mark as a sidebar row: the server's color tag and its live status dot -->
        <DataTemplate x:Key="CardIdentity" DataType="{x:Type vm:ServerNodeViewModel}">
            <Grid Width="18" Height="16">
                <Border Width="4" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{Binding ColorBrush, Converter={StaticResource BrushOr}, ConverterParameter=Line.Strong}" />
                <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ServerCard" DataType="{x:Type vm:ServerNodeViewModel}">
            <Button x:Name="Card" Style="{StaticResource CardButton}" Width="268" Height="120" Click="Card_Click" MouseDown="Card_MouseDown" Tag="{Binding}"
                    ContextMenuOpening="Card_ContextMenuOpening" AutomationProperties.Name="{Binding TreeLabel}">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardIdentity}" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <!-- Name; the star sits in the corner (shown on hover/focus, always when it's a favorite) -->
                    <Grid Grid.Column="1">
                        <TextBlock Text="{Binding TreeLabel}" FontSize="{StaticResource Size.BodyLarge}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,22,0" ToolTip="{Binding TreeLabel}" ToolTipService.InitialShowDelay="900" />
                        <Button x:Name="Star" FontSize="12" Click="CardStar_Click" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,-4,-6,-4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.IconSmall}">
                                    <Setter Property="Content" Value="&#xE734;" />
                                    <Setter Property="ToolTip" Value="{ui:Tr Favorite.Add}" />
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Card}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Warn}" />
                                            <Setter Property="ToolTip" Value="{ui:Tr Favorite.Remove}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                    <!-- Notes and tags share one line -->
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" LastChildFill="True">
                        <!-- Tags follow the notes on the right; without notes they start the line instead of floating at the edge -->
                        <TextBlock Text="{Binding TagsText}" Foreground="{DynamicResource Accent.Text}" MaxWidth="110" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasTags, Converter={StaticResource Vis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="DockPanel.Dock" Value="Right" />
                                    <Setter Property="Margin" Value="10,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                            <Setter Property="DockPanel.Dock" Value="Left" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"
                                   ToolTipService.InitialShowDelay="900" Visibility="{Binding Description, Converter={StaticResource VisIfAny}}" />
                    </DockPanel>

                    <!-- Live status, and what the server offers (each opens that view) -->
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PrimaryStatusText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Fg.Secondary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource CapButton.Smb}" Content="SMB" Click="CardFiles_Click" Tag="{Binding}" ToolTip="{ui:Tr Tree.Ctx.OpenFiles}"
                                    ui:Ui.IsOn="{Binding FilesIsDefault}" Visibility="{Binding HasFiles, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource CapButton.Rdp}" Content="RDP" Click="CardDesktop_Click" Tag="{Binding}" ToolTip="{ui:Tr Tree.Ctx.OpenDesktop}"
                                    ui:Ui.IsOn="{Binding DesktopIsDefault}" Visibility="{Binding HasDesktop, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource CapButton.Ssh}" Content="SSH" Click="CardTerminal_Click" Tag="{Binding}" ToolTip="{ui:Tr Tree.Ctx.OpenTerminal}"
                                    ui:Ui.IsOn="{Binding TerminalIsDefault}" Visibility="{Binding HasTerminal, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Connected view: a picture of the remote desktop (refreshed while it's on screen) above the identity -->
        <DataTemplate x:Key="SessionCard" DataType="{x:Type vm:ServerNodeViewModel}">
            <Button Style="{StaticResource CardButton}" Width="320" Height="246" Click="SessionCard_Click" Tag="{Binding}" AutomationProperties.Name="{Binding TreeLabel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="7,7,0,0" Background="{DynamicResource Bg.Base}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <!-- No picture yet (or no desktop): what the server offers -->
                            <TextBlock FontSize="28" Foreground="{DynamicResource Fg.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Thumbnail, Converter={StaticResource VisIfAny}, ConverterParameter=invert}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE7F4;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDesktop}" Value="False">
                                                <Setter Property="Text" Value="&#xE8B7;" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasDesktop}" Value="False" />
                                                    <Condition Binding="{Binding HasFiles}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="&#xE756;" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- A brush (not an Image) so the picture follows the card's rounded corners -->
                            <Border CornerRadius="7,7,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="14,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardIdentity}" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TreeLabel}" FontSize="{StaticResource Size.BodyLarge}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PrimaryStatusText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Fg.Secondary}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
        <Style x:Key="StatChip" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Tertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Tag = "warn" / "danger" (from the session's thresholds) tints the value. -->
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Warn}" />
                </Trigger>
                <Trigger Property="Tag" Value="danger">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Identity band: always know which server you're on ═══════════ -->
        <Border Grid.Row="0" Visibility="{Binding HasIdentity, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="5" Background="{Binding IdentityBrush, Converter={StaticResource BrushOr}, ConverterParameter=Line.Strong}" />
                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" MinWidth="60">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IdentityTitle" Text="{Binding IdentityName}" Style="{StaticResource Text.Subtitle}" FontSize="17"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityName}" />
                        <Border x:Name="HealthChip" Grid.Column="1" Margin="12,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Bg.Hover}"
                                DataContext="{Binding Health}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot.Self}" Width="7" Height="7" />
                                <TextBlock x:Name="LatencyText" Margin="6,0,0,0" Foreground="{DynamicResource Fg.Secondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Setter Property="Text" Value="—" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Online">
                                                    <Setter Property="Text" Value="{Binding LatencyMs, StringFormat={}{0} ms}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Offline">
                                                    <Setter Property="Text" Value="{ui:Tr Health.OfflineShort}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IdentityAddressText" Text="{Binding IdentityAddress}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding IdentityAddress}" />
                        <TextBlock x:Name="IdentityUser" Grid.Column="1" Text="{Binding ConnectedAs}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <!-- Same server, other view: jumps to (or opens) the companion tab; never tears this one down -->
                    <Border Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="2" Margin="0,0,10,0"
                            Visibility="{Binding ShowViewSwitch, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Segment}" Command="{Binding ShowFilesCommand}" AutomationProperties.Name="{ui:Tr Cap.Files}"
                                    ui:Ui.IsOn="{Binding IsFilesView}" ToolTip="{ui:Tr Cap.Files}"
                                    Visibility="{Binding Server.HasFiles, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FilesIcon" Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock x:Name="FilesLabel" Text="{ui:Tr Cap.Files}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Segment}" Command="{Binding ShowDesktopCommand}" ui:Ui.IsOn="{Binding IsDesktop}" AutomationProperties.Name="{ui:Tr Cap.Desktop}"
                                    ToolTip="{ui:Tr Cap.Desktop}" Visibility="{Binding Server.HasDesktop, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DesktopIcon" Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock x:Name="DesktopLabel" Text="{ui:Tr Cap.Desktop}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Segment}" Command="{Binding ShowTerminalCommand}" ui:Ui.IsOn="{Binding IsTerminal}" AutomationProperties.Name="{ui:Tr Cap.Terminal}"
                                    ToolTip="{ui:Tr Cap.Terminal}" Visibility="{Binding Server.HasTerminal, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TerminalIcon" Text="&#xE756;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TerminalLabel" Text="{ui:Tr Cap.Terminal}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="IdentityExplorer" Style="{StaticResource Btn.Icon}" Content="&#xEC50;" ToolTip="{ui:Tr Nav.OpenExplorer}" Command="{Binding OpenInExplorerCommand}"
                            Visibility="{Binding IsRemote, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE70F;" ToolTip="{ui:Tr Tree.Ctx.Properties}" Click="EditServer_Click"
                            Visibility="{Binding Server, Converter={StaticResource VisIfAny}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Desktop toolbar ═══════════ -->
        <Grid Grid.Row="1" Height="46" Margin="8,0,8,0" Visibility="{Binding IsDesktop, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72B;" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="{ui:Tr Nav.Back}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72A;" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="{ui:Tr Nav.Forward}" />
                <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="6,0" />
                <Button x:Name="DesktopFocusTarget" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" Command="{Binding Session.ReconnectCommand}" ToolTip="{ui:Tr Desktop.Reconnect}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE765;" Command="{Binding Session.SendCtrlAltDelCommand}" ToolTip="{ui:Tr Desktop.CtrlAltDel}"
                        IsEnabled="{Binding Session.IsConnected}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE740;" Command="{Binding Session.FullScreenCommand}" ToolTip="{ui:Tr Desktop.FullScreen}"
                        IsEnabled="{Binding Session.IsConnected}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8A7;" Command="{Binding UndockCommand}" ToolTip="{ui:Tr Undock.Open}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE7E8;" Command="{Binding Session.DisconnectCommand}" ToolTip="{ui:Tr Desktop.Disconnect}"
                        IsEnabled="{Binding Session.IsConnected}" />
            </StackPanel>
            <TextBlock x:Name="DesktopHint" Grid.Column="2" Text="{ui:Tr Desktop.FocusHint}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0"
                       Visibility="{Binding Session.IsConnected, Converter={StaticResource Vis}}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ═══════════ Terminal toolbar ═══════════ -->
        <Grid x:Name="TerminalBar" Grid.Row="1" Height="46" Margin="8,0,8,0" Visibility="{Binding IsTerminal, Converter={StaticResource Vis}}"
              DataContext="{Binding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72B;" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="{ui:Tr Nav.Back}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72A;" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="{ui:Tr Nav.Forward}" />
                <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="6,0" />
                <Button x:Name="TerminalFocusTarget" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" Command="{Binding TerminalSession.ReconnectCommand}" ToolTip="{ui:Tr Desktop.Reconnect}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE721;" Command="{Binding TerminalSession.SearchCommand}" ToolTip="{ui:Tr Term.Tip.Search}"
                        IsEnabled="{Binding TerminalSession.IsSurfaceVisible, FallbackValue=False}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8C8;" Command="{Binding TerminalSession.CopyLastOutputCommand}" ToolTip="{ui:Tr Term.Tip.CopyOutput}"
                        IsEnabled="{Binding TerminalSession.IsSurfaceVisible, FallbackValue=False}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE74E;" Command="{Binding TerminalSession.SaveOutputCommand}" ToolTip="{ui:Tr Term.Tip.Save}"
                        IsEnabled="{Binding TerminalSession.IsSurfaceVisible, FallbackValue=False}" />
                <Button Style="{StaticResource Btn.IconToggle}" Content="&#xE8B7;" Command="{Binding TerminalSession.ToggleSftpCommand}" ToolTip="{ui:Tr Term.Tip.Sftp}"
                        ui:Ui.IsOn="{Binding TerminalSession.IsSftpOpen, FallbackValue=False}" IsEnabled="{Binding TerminalSession.IsSurfaceVisible, FallbackValue=False}" />
                <Button Style="{StaticResource Btn.IconToggle}" Content="&#xE789;" Command="{Binding TerminalSession.ToggleBroadcastCommand}" ToolTip="{ui:Tr Term.Tip.Broadcast}"
                        ui:Ui.IsOn="{Binding TerminalSession.IsBroadcasting, FallbackValue=False}" IsEnabled="{Binding TerminalSession.IsConnected, FallbackValue=False}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE740;" Command="{Binding TerminalSession.FullScreenCommand}" ToolTip="{ui:Tr Desktop.FullScreen}"
                        IsEnabled="{Binding TerminalSession.IsSurfaceVisible, FallbackValue=False}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE7E8;" Command="{Binding TerminalSession.DisconnectCommand}" ToolTip="{ui:Tr Desktop.Disconnect}"
                        IsEnabled="{Binding TerminalSession.IsLive, FallbackValue=False}" />
            </StackPanel>

            <!-- Port forwards: one chip each, live state, menu on click -->
            <ItemsControl Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" ItemsSource="{Binding TerminalSession.Forwards}" Focusable="False" ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Chip" Style="{StaticResource Btn.Subtle}" Height="26" Padding="8,0" Margin="0,0,6,0" ToolTip="{Binding ToolTip}" Click="ForwardChip_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Status.Unknown}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Mono}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Online}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Offline}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Live server stats (Linux), or the connection state -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" DataContext="{Binding TerminalSession}">
                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Visibility="{Binding HasStats, Converter={StaticResource Vis}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Visibility="{Binding HasStats, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                    <TextBlock x:Name="StatsOs" Text="{Binding OsName}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                               MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding OsName}" />
                    <Border Style="{StaticResource StatChip}" ToolTip="{ui:Tr Term.Stats.Cpu}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ui:Tr Term.Stats.CpuShort}" Style="{StaticResource StatLabel}" />
                            <Polyline Points="{Binding CpuSparkline}" Stroke="{DynamicResource Accent}" StrokeThickness="1.25" Width="40" Height="14"
                                      Margin="6,0" VerticalAlignment="Center" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" Style="{StaticResource StatValue}" Tag="{Binding CpuLevel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatChip}" ToolTip="{Binding MemText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ui:Tr Term.Stats.RamShort}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding MemPercent, StringFormat={}{0:0}%}" Style="{StaticResource StatValue}" Margin="6,0,0,0" Tag="{Binding MemLevel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatChip}" ToolTip="{Binding DiskText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="/" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:0}%}" Style="{StaticResource StatValue}" Margin="6,0,0,0" Tag="{Binding DiskLevel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatChip}" ToolTip="{ui:Tr Term.Stats.Load}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ui:Tr Term.Stats.LoadShort}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding LoadText}" Style="{StaticResource StatValue}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatChip}" ToolTip="{ui:Tr Term.Stats.Uptime}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UptimeText}" Style="{StaticResource StatValue}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Toolbar ═══════════ -->
        <Grid Grid.Row="1" Height="46" Margin="8,0,8,0" Visibility="{Binding IsRemote, Converter={StaticResource Vis}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72B;" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="{ui:Tr Nav.Back}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72A;" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="{ui:Tr Nav.Forward}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE74A;" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip="{ui:Tr Nav.Up}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="{ui:Tr Nav.Refresh}" />
            </StackPanel>

            <!-- Address: breadcrumb, or an editable path -->
            <Border Grid.Column="1" Margin="8,0" Height="32" CornerRadius="6" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" VerticalAlignment="Center" MouseLeftButtonDown="AddressBar_MouseLeftButtonDown" Cursor="IBeam">
                <Grid x:Name="CrumbHost" ClipToBounds="True">
                    <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Breadcrumb}" Margin="2,0" VerticalAlignment="Center" Cursor="Arrow"
                                  Visibility="{Binding IsEditingPath, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BreadcrumbSegment}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Sep" Text="&#xE76C;" FontFamily="{StaticResource Font.Icons}" FontSize="8" Foreground="{DynamicResource Fg.Tertiary}"
                                               VerticalAlignment="Center" Margin="2,0" />
                                    <Button Style="{StaticResource Crumb}" Command="{Binding DataContext.NavigateSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AllowDrop="True" Tag="{Binding Target}" DragOver="Crumb_DragOver" Drop="Crumb_Drop">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Dot" Width="8" Height="8" CornerRadius="2" Margin="0,0,7,0" Background="{Binding Color}" Visibility="Collapsed" />
                                            <TextBlock x:Name="Label" Text="{Binding Label}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsServer}" Value="True">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color, Converter={StaticResource NotNull}}" Value="True">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="PathBox" Style="{StaticResource TextBox.Mono}" BorderThickness="0" Background="Transparent" MinHeight="30"
                             Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="{ui:Tr Nav.EditPath}" ui:Ui.SelectAllOnFocus="True"
                             Visibility="{Binding IsEditingPath, Converter={StaticResource Vis}}" IsVisibleChanged="PathBox_IsVisibleChanged"
                             PreviewKeyDown="PathBox_PreviewKeyDown" LostKeyboardFocus="PathBox_LostKeyboardFocus" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" Width="200" Margin="0,0,6,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                         ui:Ui.Hint="{ui:Tr Nav.Filter}" Visibility="{Binding IsFilterOpen, Converter={StaticResource Vis}}"
                         IsVisibleChanged="FilterBox_IsVisibleChanged" PreviewKeyDown="FilterBox_PreviewKeyDown" />
                <Button Style="{StaticResource Btn.IconToggle}" Content="&#xE71C;" ui:Ui.IsOn="{Binding IsFilterOpen}"
                        Command="{Binding ToggleFilterCommand}" ToolTip="{ui:Tr Nav.Filter}" IsEnabled="{Binding HasItems}" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8F4;" Command="{Binding NewFolderCommand}" ToolTip="{ui:Tr Nav.NewFolder}"
                        IsEnabled="{Binding CanWrite}" />
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="2" Style="{StaticResource Progress.Thin}" IsIndeterminate="{Binding ShowSpinner}"
                     Visibility="{Binding ShowSpinner, Converter={StaticResource Vis}}" />
        <Border Grid.Row="2" Height="1" Background="{DynamicResource Line}" Visibility="{Binding ShowSpinner, Converter={StaticResource Vis}, ConverterParameter=invert}" />

        <!-- ═══════════ Content ═══════════ -->
        <Grid Grid.Row="3" x:Name="ContentArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SftpSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="SftpColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <!-- A session's native surface is placed exactly over this element (the window's overlay measures it) -->
            <Border x:Name="SessionSurface" IsHitTestVisible="False" />
            <!-- SFTP side panel of a terminal (columns sized in code: closed = 0) -->
            <GridSplitter x:Name="SftpSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Line}" Visibility="Collapsed" DragCompleted="SftpSplitter_DragCompleted" Focusable="False" />
            <v:SftpPanel x:Name="SftpPanelView" Grid.Column="2" Visibility="Collapsed" DataContext="{Binding TerminalSession.Sftp}"
                         CloseRequested="SftpPanel_CloseRequested" />
            <!-- Desktop: not connected -->
            <StackPanel x:Name="IdlePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="32"
                        Visibility="{Binding Session.ShowIdle, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                <Border x:Name="IdleIcon" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Accent.Subtle}" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Session.IdleGlyph}" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Accent.Text}" />
                </Border>
                <TextBlock Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,18,0,8" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding Session.Server.Name}" />
                <TextBlock x:Name="IdleBody" Text="{Binding Session.IdleText}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="140" Height="36"
                        Command="{Binding Session.ConnectCommand}" AutomationProperties.Name="{ui:Tr Desktop.Connect}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Session.IdleGlyph}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{ui:Tr Desktop.Connect}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Desktop: error -->
            <!-- FallbackValue: tabs without a session (files, dashboards) must never render this template -->
            <ContentControl Content="{Binding Session.Error}" Focusable="False"
                            Visibility="{Binding Session.Error, Converter={StaticResource VisIfAny}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:ErrorInfo}">
                        <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Danger.Subtle}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Danger}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,18,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" FontSize="14" LineHeight="21" />
                            <TextBlock Text="{Binding CodeText}" Style="{StaticResource Text.Mono}" FontSize="11.5" Foreground="{DynamicResource Fg.Tertiary}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Content="{Binding PrimaryText}"
                                        Command="{Binding DataContext.Session.ErrorPrimaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- File list -->
            <ListView x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="0,2,0,6"
                      SelectionMode="Extended" ItemContainerStyle="{StaticResource FileRow}" AllowDrop="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.IsDeferredScrollingEnabled="False" KeyboardNavigation.DirectionalNavigation="Cycle"
                      Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Folder}"
                      SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" MouseDown="List_MouseDown"
                      PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown" ContextMenuOpening="List_ContextMenuOpening"
                      DragEnter="List_DragOver" DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop">
                <ListView.ContextMenu>
                    <ContextMenu />
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="380">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Click="Header_Click" Tag="Name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ui:Tr Col.Name}" />
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Name">
                                                    <Binding Path="SortColumn" />
                                                    <Binding Path="SortDescending" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" Margin="0,0,10,0">
                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Fg.Secondary}"
                                                       Visibility="{Binding Icon, Converter={StaticResource VisIfAny}, ConverterParameter=invert}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg.Primary}" />
                                            <TextBlock Text="{Binding SecondaryText}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding SecondaryText, Converter={StaticResource VisIfAny}}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinHeight="24" Height="24"
                                                 Padding="4,0" Margin="-7,0,8,0" Visibility="{Binding IsRenaming, Converter={StaticResource Vis}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_PreviewKeyDown"
                                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus" ui:Ui.CornerRadius="4" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="160">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Click="Header_Click" Tag="Modified">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ui:Tr Col.Modified}" />
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Modified">
                                                    <Binding Path="SortColumn" />
                                                    <Binding Path="SortDescending" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource CellText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="170">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Click="Header_Click" Tag="Type">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ui:Tr Col.Type}" />
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Type">
                                                    <Binding Path="SortColumn" />
                                                    <Binding Path="SortDescending" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource CellText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Click="Header_Click" Tag="Size" HorizontalContentAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="9" Margin="0,1,8,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Size">
                                                    <Binding Path="SortColumn" />
                                                    <Binding Path="SortDescending" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{ui:Tr Col.Size}" Margin="0,0,8,0" />
                                    </StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource CellText}" HorizontalAlignment="Right" Margin="0,0,8,0"
                                               Typography.NumeralAlignment="Tabular" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Empty folder -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False"
                        Visibility="{Binding IsEmptyFolder, Converter={StaticResource Vis}}">
                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource Fg.Tertiary}" Opacity="0.6" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Subtitle}" FontSize="15" HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Filter has no matches -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsFilteredEmpty, Converter={StaticResource Vis}}">
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource Fg.Tertiary}" Opacity="0.6" />
                <TextBlock Text="{Binding NoMatchText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>

            <!-- Connecting / reading (only after a short delay, so fast folders never flash) -->
            <Grid Background="{DynamicResource Bg.Content}" Visibility="{Binding ShowSpinner, Converter={StaticResource Vis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent.Text}" />
                    <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>

            <!-- Error -->
            <ScrollViewer Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Error}" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Error}">
                                        <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:ErrorInfo}">
                            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,72,32,32">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Danger.Subtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Danger}" />
                                </Border>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,18,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" FontSize="14" LineHeight="21" />
                                <TextBlock Text="{Binding CodeText}" Style="{StaticResource Text.Mono}" FontSize="11.5" Foreground="{DynamicResource Fg.Tertiary}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                    <Button Style="{StaticResource Btn.Primary}" Content="{Binding PrimaryText}" Margin="0,0,8,0"
                                            Visibility="{Binding HasPrimary, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.ErrorPrimaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Content="{ui:Tr Common.Retry}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>

            <!-- Dashboard (Home / group) -->
            <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" Padding="28,24,16,24"
                          Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Dashboard}">
                <StackPanel DataContext="{Binding Dashboard}">
                    <Grid Margin="0,0,12,22">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Display}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Margin="8,0,0,0" Click="DashboardEditGroup_Click" Visibility="{Binding CanEdit, Converter={StaticResource Vis}}"
                                    AutomationProperties.Name="{ui:Tr Common.Edit}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ui:Tr Common.Edit}" />
                                </StackPanel>
                            </Button>
                            <!-- When empty, the onboarding card below carries the primary action instead -->
                            <Button Style="{StaticResource Btn.Primary}" Click="DashboardNewServer_Click" Margin="8,0,0,0" AutomationProperties.Name="{ui:Tr Server.TitleNew}"
                                    Visibility="{Binding ShowNewServer, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{ui:Tr Server.TitleNew}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DashboardSection}">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="12.5" Margin="0,0,0,10"
                                               Visibility="{Binding HasTitle, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Servers}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="ItemTemplate" Value="{StaticResource ServerCard}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Dashboard.ShowThumbnails, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                                                        <Setter Property="ItemTemplate" Value="{StaticResource SessionCard}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty dashboard -->
                    <Border Style="{StaticResource Surface.Card}" Padding="28" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding IsTreeDashboard, Converter={StaticResource Vis}}">
                                <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr Server.TitleNew}" Click="DashboardNewServer_Click" />
                                <Button Content="{ui:Tr Menu.ImportNetUse}" Margin="8,0,0,0" Click="DashboardImport_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
