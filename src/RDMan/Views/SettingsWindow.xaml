<v:DialogWindow x:Class="RDMan.Views.SettingsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                Title="{ui:Tr Title.Settings}" Width="560">
    <v:DialogWindow.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Group" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
            <Setter Property="Padding" Value="16,14,16,2" />
            <Setter Property="Margin" Value="0,8,0,18" />
        </Style>
    </v:DialogWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource Dialog.Body}">
                <TextBlock Text="{ui:Tr Settings.Appearance}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Theme}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="theme" Content="{ui:Tr Settings.Theme.System}"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="theme" Content="{ui:Tr Settings.Theme.Dark}"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Dark}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="theme" Content="{ui:Tr Settings.Theme.Light}"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Light}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Language}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="lang" Content="{ui:Tr Settings.Language.System}"
                                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=system}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="lang" Content="Español"
                                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=es}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="lang" Content="English"
                                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=en}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Density}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="density" Content="{ui:Tr Settings.Density.Comfortable}"
                                                 IsChecked="{Binding Density, Converter={StaticResource Eq}, ConverterParameter=Comfortable}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="density" Content="{ui:Tr Settings.Density.Compact}"
                                                 IsChecked="{Binding Density, Converter={StaticResource Eq}, ConverterParameter=Compact}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{ui:Tr Settings.Browsing}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.ShowHiddenFiles}" IsChecked="{Binding ShowHiddenFiles}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.ShowHiddenShares}" IsChecked="{Binding ShowHiddenShares}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.RestoreTabs}" IsChecked="{Binding RestoreTabs}" Margin="0,0,0,14" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{ui:Tr Settings.Connections}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.HealthInterval}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding HealthInterval}" Width="90" />
                                <TextBlock Text="{ui:Tr Settings.Seconds}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Fg.Secondary}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.DisconnectOnExit}" IsChecked="{Binding DisconnectOnExit}" Margin="0,0,0,14" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{ui:Tr Settings.Terminal}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                <Border Style="{StaticResource Group}" DataContext="{Binding Terminal}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.Font}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding Fonts}" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="200"
                                          AutomationProperties.Name="{ui:Tr Settings.Terminal.Font}" />
                                <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding FontSize}" Width="70" Margin="8,0,0,0"
                                          AutomationProperties.Name="{ui:Tr Settings.Terminal.Size}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.Colors}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" Width="278" ItemsSource="{Binding Schemes}" SelectedItem="{Binding Scheme}"
                                      AutomationProperties.Name="{ui:Tr Settings.Terminal.Colors}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding Background}" CornerRadius="3" Padding="4,3" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="7" Height="10" Background="{Binding}" Margin="0,0,2,0" CornerRadius="1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.Rendering}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="renderer" Content="{ui:Tr Settings.Terminal.Gpu}"
                                                 IsChecked="{Binding Renderer, Converter={StaticResource Eq}, ConverterParameter=Gpu}" ToolTip="{ui:Tr Settings.Terminal.GpuTip}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="renderer" Content="ClearType"
                                                 IsChecked="{Binding Renderer, Converter={StaticResource Eq}, ConverterParameter=Subpixel}" ToolTip="{ui:Tr Settings.Terminal.ClearTypeTip}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.LineHeight}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right" ItemsSource="{Binding LineHeights}" SelectedItem="{Binding LineHeight}" Width="90"
                                      AutomationProperties.Name="{ui:Tr Settings.Terminal.LineHeight}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.Cursor}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="cursor" Content="{ui:Tr Settings.Terminal.Cursor.Bar}"
                                                 IsChecked="{Binding Cursor, Converter={StaticResource Eq}, ConverterParameter=Bar}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="cursor" Content="{ui:Tr Settings.Terminal.Cursor.Block}"
                                                 IsChecked="{Binding Cursor, Converter={StaticResource Eq}, ConverterParameter=Block}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="cursor" Content="{ui:Tr Settings.Terminal.Cursor.Underline}"
                                                 IsChecked="{Binding Cursor, Converter={StaticResource Eq}, ConverterParameter=Underline}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.Scrollback}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding ScrollbackSizes}" SelectedItem="{Binding Scrollback}" Width="100"
                                          AutomationProperties.Name="{ui:Tr Settings.Terminal.Scrollback}" />
                                <TextBlock Text="{ui:Tr Settings.Terminal.Lines}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Fg.Secondary}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.RightClick}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="rightclick" Content="{ui:Tr Settings.Terminal.RightClick.Menu}"
                                                 IsChecked="{Binding RightClick, Converter={StaticResource Eq}, ConverterParameter=Menu}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="rightclick" Content="{ui:Tr Settings.Terminal.RightClick.CopyPaste}"
                                                 IsChecked="{Binding RightClick, Converter={StaticResource Eq}, ConverterParameter=CopyPaste}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{ui:Tr Settings.Terminal.Bell}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="bell" Content="{ui:Tr Settings.Terminal.Bell.Visual}"
                                                 IsChecked="{Binding Bell, Converter={StaticResource Eq}, ConverterParameter=Visual}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="bell" Content="{ui:Tr Settings.Terminal.Bell.Sound}"
                                                 IsChecked="{Binding Bell, Converter={StaticResource Eq}, ConverterParameter=Sound}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="bell" Content="{ui:Tr Settings.Terminal.Bell.Off}"
                                                 IsChecked="{Binding Bell, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.Terminal.CursorBlink}" IsChecked="{Binding CursorBlink}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.Terminal.Tint}" IsChecked="{Binding TintWithServerColor}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.Terminal.Contrast}" IsChecked="{Binding EnsureContrast}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.Terminal.SmartCtrlC}" IsChecked="{Binding SmartCtrlC}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.Terminal.CopyOnSelect}" IsChecked="{Binding CopyOnSelect}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.Terminal.PasteWarning}" IsChecked="{Binding WarnMultilinePaste}" Margin="0,0,0,14" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{ui:Tr Settings.Updates}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Settings.AutoUpdate}" IsChecked="{Binding AutoUpdate}" Margin="0,0,0,14" />
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Secondary}" />
                            <Button HorizontalAlignment="Right" Content="{ui:Tr Menu.CheckUpdates}" Command="{Binding CheckUpdatesCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{ui:Tr Settings.DataFolder}" Style="{StaticResource Text.Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Text.Mono}" MaxWidth="420" VerticalAlignment="Center" ToolTip="{Binding DataDirectory}" />
                    <Button Style="{StaticResource Btn.IconSmall}" Content="&#xE8A7;" FontSize="11" Margin="6,0,0,0" Command="{Binding OpenDataFolderCommand}"
                            ToolTip="{ui:Tr Menu.OpenDataFolder}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}" Content="{ui:Tr Common.Close}" MinWidth="96" IsDefault="True" IsCancel="True" />
        </Border>
    </Grid>
</v:DialogWindow>
