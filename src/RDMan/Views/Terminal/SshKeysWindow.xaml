<v:DialogWindow x:Class="RDMan.Views.SshKeysWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                xmlns:tvm="clr-namespace:RDMan.ViewModels.Terminal"
                Title="{ui:Tr SshKeys.Title}" Width="680">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource Dialog.Body}">
            <Grid Margin="0,0,0,14">
                <TextBlock Text="{ui:Tr SshKeys.Intro}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,160,0" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{ui:Tr Term.Editor.Key.Import}" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource Surface.Card}" Padding="0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" MaxHeight="420">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tvm:SshKeyItemViewModel}">
                                <Border BorderBrush="{DynamicResource Line.Subtle}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Accent.Subtle}" VerticalAlignment="Top" Margin="0,2,14,0">
                                            <TextBlock x:Name="KeyIcon" Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent.Text}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" MaxWidth="320" HorizontalAlignment="Left"
                                                         MinWidth="200" AutomationProperties.Name="{ui:Tr Snippets.Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource Text.Mono}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Key.Fingerprint}" Style="{StaticResource Text.Mono}" FontSize="11.5" Foreground="{DynamicResource Fg.Secondary}"
                                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding UsageText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Details, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Btn.IconSmall}" Content="&#xE74D;" VerticalAlignment="Top" Margin="12,4,0,0"
                                                ToolTip="{ui:Tr Common.Delete}" AutomationProperties.Name="{ui:Tr Common.Delete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter TargetName="KeyIcon" Property="Foreground" Value="{DynamicResource Status.Warn}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{ui:Tr SshKeys.Empty}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="20,18"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" Margin="0,0,8,0" />
                <TextBlock Text="{ui:Tr Term.Editor.Auth.Stored}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="580" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr Common.Close}" MinWidth="96" IsDefault="True" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
