<v:DialogWindow x:Class="RDMan.Views.PassphraseWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                Width="440">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource Dialog.Body}">
            <Border Style="{StaticResource Surface.Card}" Padding="14,10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center" />
                    <TextBlock x:Name="KeyName" Style="{StaticResource Text.Mono}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <TextBlock Text="{ui:Tr Term.Prompt.Passphrase.Body}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Text="{ui:Tr Term.Prompt.Passphrase.Label}" Style="{StaticResource Text.Label}" />
                <PasswordBox x:Name="PassBox" Tag="empty" PasswordChanged="PassBox_PasswordChanged" />
                <TextBlock x:Name="WrongText" Text="{ui:Tr SshErr.KeyPassphrase.Title}" Foreground="{DynamicResource Danger}" Style="{StaticResource Text.Caption}"
                           Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
            <CheckBox x:Name="RememberBox" Style="{StaticResource Switch}" Content="{ui:Tr Term.Editor.Key.RememberPassphrase}" IsChecked="True" />
            <TextBlock Text="{ui:Tr Term.Editor.Key.StoredNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr Term.Prompt.Unlock}" IsDefault="True" MinWidth="96" Click="Unlock_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
