<v:DialogWindow x:Class="RDMan.Views.SshConfigImportWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                xmlns:vm="clr-namespace:RDMan.ViewModels"
                xmlns:tvm="clr-namespace:RDMan.ViewModels.Terminal"
                Title="{ui:Tr SshImport.Title}" Width="620">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource Dialog.Body}">
            <TextBlock Text="{ui:Tr SshImport.Intro}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Text.Mono}" Margin="0,0,0,14" />
            <Border Style="{StaticResource Surface.Card}" Padding="0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Hosts}" Focusable="False" MaxHeight="360">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tvm:ConfigHostItem}">
                                <Border BorderBrush="{DynamicResource Line.Subtle}" BorderThickness="0,0,0,1" Padding="14,10">
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanImport}" VerticalContentAlignment="Top">
                                        <StackPanel Margin="4,-1,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Mono}" FontSize="11.5" Margin="12,1,0,0" Foreground="{DynamicResource Fg.Secondary}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                       Visibility="{Binding Details, Converter={StaticResource VisIfAny}}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{ui:Tr SshImport.Empty}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="20,18"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Status.Warn}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" />
            <StackPanel Style="{StaticResource Field}" Margin="0,16,0,0">
                <TextBlock Text="{ui:Tr SshImport.Group}" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" MaxDropDownHeight="320" AutomationProperties.Name="{ui:Tr SshImport.Group}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupChoice}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{Binding Depth, Converter={StaticResource Mul}, ConverterParameter=14}" />
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="{ui:Tr SshImport.Live}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr SshImport.Do}" IsDefault="True" MinWidth="96" Click="Import_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
