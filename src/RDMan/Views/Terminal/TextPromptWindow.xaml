<v:DialogWindow x:Class="RDMan.Views.TextPromptWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                Width="440">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource Dialog.Body}">
            <TextBlock x:Name="BodyText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Style="{StaticResource Field}">
                <TextBlock x:Name="LabelText" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="ValueBox" Style="{StaticResource TextBox.Mono}" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Style="{StaticResource Btn.Primary}" IsDefault="True" MinWidth="96" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
