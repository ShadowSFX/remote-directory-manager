<v:DialogWindow x:Class="RDMan.Views.RdgImportWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                Title="{ui:Tr Rdg.Title}" Width="520">
    <v:DialogWindow.Resources>
        <!-- One summary line: glyph · text, aligned on a 20px icon column -->
        <Style x:Key="SummaryLine" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SummaryIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        </Style>
    </v:DialogWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource Dialog.Body}">
            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                <Run Text="{ui:Tr Rdg.Intro}" /><Run Text=" " /><Run Text="{Binding GroupName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}" /><Run Text="." />
            </TextBlock>

            <Border Style="{StaticResource Surface.Card}" Padding="16,14,16,4">
                <StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource SummaryIcon}" />
                        <TextBlock Text="{Binding ServersText}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource SummaryIcon}" />
                        <TextBlock Text="{Binding GroupsText}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource SummaryIcon}" />
                        <TextBlock Text="{Binding ProfilesText}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}" Visibility="{Binding HasSmartGroups, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource SummaryIcon}" />
                        <TextBlock Text="{Binding SmartGroupsText}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}" Visibility="{Binding HasPasswords, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource SummaryIcon}" Foreground="{DynamicResource Status.Online}" />
                        <TextBlock Text="{Binding PasswordsText}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}" Visibility="{Binding HasLostPasswords, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource SummaryIcon}" Foreground="{DynamicResource Status.Warn}" />
                        <TextBlock Text="{Binding LostPasswordsText}" TextWrapping="Wrap" MaxWidth="400" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource SummaryLine}" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SummaryIcon}" />
                        <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" MaxWidth="400" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <StackPanel Margin="0,0,64,0">
                    <TextBlock Text="{ui:Tr Rdg.OfferFiles}" />
                    <TextBlock Text="{ui:Tr Rdg.OfferFilesHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OfferFiles}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          AutomationProperties.Name="{ui:Tr Rdg.OfferFiles}" />
            </Grid>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr Rdg.Import}" IsDefault="True" MinWidth="96" Click="Import_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
