<v:DialogWindow x:Class="RDMan.Views.CredentialPromptWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                Width="440">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource Dialog.Body}">
            <!-- Identity strip: which server you're typing a password for -->
            <Border Style="{StaticResource Surface.Card}" Padding="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IdentityBar" CornerRadius="7,0,0,7" />
                    <StackPanel Grid.Column="1" Margin="14,10">
                        <TextBlock x:Name="ServerName" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServerAddress" Style="{StaticResource Text.Mono}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="BodyText" Style="{StaticResource Text.Secondary}" Margin="0,0,0,14" />
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Text="{ui:Tr Cred.Username}" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="UserBox" ui:Ui.Hint="{ui:Tr Cred.UsernameHint}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Text="{ui:Tr Cred.Password}" Style="{StaticResource Text.Label}" />
                <PasswordBox x:Name="PasswordBox" Tag="empty" PasswordChanged="PasswordBox_PasswordChanged" />
            </StackPanel>
            <CheckBox x:Name="RememberBox" Style="{StaticResource Switch}" Content="{ui:Tr CredPrompt.Remember}" IsChecked="True" />
            <TextBlock x:Name="StoredText" Text="{ui:Tr Cred.Stored}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr CredPrompt.Connect}" IsDefault="True" MinWidth="96" Click="Connect_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
