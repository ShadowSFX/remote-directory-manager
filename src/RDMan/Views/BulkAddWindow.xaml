<v:DialogWindow x:Class="RDMan.Views.BulkAddWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                xmlns:vm="clr-namespace:RDMan.ViewModels"
                Title="{ui:Tr Bulk.Title}" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource Dialog.Body}">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="{ui:Tr Bulk.Hosts}" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="PatternsBox" Text="{Binding Patterns, UpdateSourceTrigger=PropertyChanged, Delay=200}" Style="{StaticResource TextBox.Mono}"
                             AcceptsReturn="True" TextWrapping="NoWrap" Height="108" VerticalContentAlignment="Top" Padding="10,8"
                             VerticalScrollBarVisibility="Auto" ui:Ui.Hint="web[1-5]&#x0a;db[01-03].corp.local" />
                    <TextBlock Text="{ui:Tr Bulk.HostsHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Server.Group}" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" MaxDropDownHeight="320">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupChoice}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="{Binding Depth, Converter={StaticResource Mul}, ConverterParameter=14}" />
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{ui:Tr Server.Tags}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="{ui:Tr Server.TagsHint}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Surface.Card}" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{ui:Tr Bulk.OfferFiles}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OfferFiles}" HorizontalAlignment="Right" AutomationProperties.Name="{ui:Tr Bulk.OfferFiles}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{ui:Tr Bulk.OfferDesktop}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center"
                                        Visibility="{Binding OfferDesktop, Converter={StaticResource Vis}}">
                                <TextBlock Text="{ui:Tr Server.Desktop.PortLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding DesktopPort, UpdateSourceTrigger=PropertyChanged}" Width="80" Style="{StaticResource TextBox.Mono}"
                                         AutomationProperties.Name="{ui:Tr Server.Desktop.PortLabel}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding OfferDesktop}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{ui:Tr Bulk.OfferDesktop}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live preview -->
                <Border Style="{StaticResource Surface.Card}" Padding="16,12" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent.Text}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewHosts}" Style="{StaticResource Text.Mono}" FontSize="12" TextWrapping="Wrap" Margin="23,4,0,0"
                                   Visibility="{Binding PreviewHosts, Converter={StaticResource VisIfAny}}" />
                        <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="23,6,0,0"
                                   Visibility="{Binding PreviewNote, Converter={StaticResource VisIfAny}}" />
                        <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="23,6,0,0"
                                   Visibility="{Binding PreviewError, Converter={StaticResource VisIfAny}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                           Visibility="{Binding ValidationError, Converter={StaticResource VisIfAny}}" />
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{Binding ConfirmText}" MinWidth="96" Click="Add_Click" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
