<v:DialogWindow x:Class="RDMan.Views.ImportWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                xmlns:vm="clr-namespace:RDMan.ViewModels"
                Title="{ui:Tr Import.Title}" Width="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{ui:Tr Import.Subtitle}" Style="{StaticResource Text.Secondary}" Margin="24,0,24,12" />
        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,0,24,20">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImportRowViewModel}">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,0,0,2" Padding="0" FocusVisualStyle="{StaticResource Focus.Ring}">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource Fg.Tertiary}"
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Fg.Primary}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Visibility="{Binding Detail, Converter={StaticResource VisIfAny}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{ui:Tr Import.None}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,24"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{Binding ConfirmText}" IsDefault="True" MinWidth="96" Click="Import_Click"
                        IsEnabled="{Binding HasSelection}" />
            </StackPanel>
        </Border>
    </Grid>
</v:DialogWindow>
