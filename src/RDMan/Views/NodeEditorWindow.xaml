<v:DialogWindow x:Class="RDMan.Views.NodeEditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                xmlns:vm="clr-namespace:RDMan.ViewModels"
                Title="{Binding Title}" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource Dialog.Body}">

                <!-- Name -->
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="{ui:Tr Server.Name}" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" MinHeight="36"
                             ui:Ui.Hint="{ui:Tr Server.NameHint}" />
                </StackPanel>

                <!-- Server address -->
                <StackPanel DataContext="{Binding ServerFields}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Server.Address}" Style="{StaticResource Text.Label}" />
                            <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}"
                                     ui:Ui.Hint="10.0.0.12" />
                            <TextBlock Text="{ui:Tr Server.AddressHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{ui:Tr Server.Share}" Style="{StaticResource Text.Label}" />
                            <Grid>
                                <TextBox Text="{Binding Share, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="{ui:Tr Common.Optional}"
                                         Padding="10,0,34,0" />
                                <Button x:Name="ShareMenuButton" Style="{StaticResource Btn.IconSmall}" Content="&#xE70D;" HorizontalAlignment="Right" Margin="0,0,4,0"
                                        ToolTip="{ui:Tr Server.PickShare}" Click="ShareMenuButton_Click"
                                        Visibility="{Binding HasDiscoveredShares, Converter={StaticResource Vis}}" />
                            </Grid>
                            <TextBlock Text="{ui:Tr Server.ShareHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource Warn.Subtle}" CornerRadius="6" Padding="12,8" Margin="0,-4,0,16"
                            Visibility="{Binding DuplicateWarning, Converter={StaticResource VisIfAny}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Status.Warn}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding DuplicateWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Primary}" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Server.StartFolder}" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding StartFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="{ui:Tr Common.Optional}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{ui:Tr Server.Tags}" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="{ui:Tr Server.TagsHint}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Group + color -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{ui:Tr Server.Group}" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" MaxDropDownHeight="320">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupChoice}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="{Binding Depth, Converter={StaticResource Mul}, ConverterParameter=14}" />
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{ui:Tr Server.Color}" Style="{StaticResource Text.Label}" />
                        <ItemsControl ItemsSource="{Binding Colors}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorChoice}">
                                    <RadioButton Style="{StaticResource Radio.Swatch}" GroupName="color" Background="{Binding Brush}" ToolTip="{Binding Label}"
                                                 BorderBrush="{DynamicResource Line.Strong}" Margin="0,0,1,0" Width="25" Height="25"
                                                 Tag="{Binding Key}" Checked="Swatch_Checked" Loaded="Swatch_Loaded" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Credentials -->
                <Border x:Name="CredentialsSection" Style="{StaticResource Surface.Card}" Padding="16,14" Margin="0,4,0,16" DataContext="{Binding Credentials}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{ui:Tr Cred.Section}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Content="{ui:Tr Cred.ManageProfiles}" Command="{Binding ManageProfilesCommand}" />
                        </Grid>
                        <TextBlock Text="{ui:Tr Group.CredentialsNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding DataContext.IsServer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />

                        <RadioButton Style="{StaticResource Radio.Option}" GroupName="cred" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Inherit}">
                            <StackPanel>
                                <TextBlock Text="{ui:Tr Cred.Mode.Inherit}" />
                                <TextBlock Text="{Binding InheritText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Radio.Option}" GroupName="cred" Content="{ui:Tr Cred.Mode.CurrentUser}"
                                     IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=CurrentUser}" />
                        <RadioButton Style="{StaticResource Radio.Option}" GroupName="cred" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                                     Content="{ui:Tr Cred.Mode.Custom}" />
                        <StackPanel Margin="36,4,0,8" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{ui:Tr Cred.Username}" Style="{StaticResource Text.Label}" FontWeight="Normal" Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="{ui:Tr Cred.UsernameHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{ui:Tr Cred.Password}" Style="{StaticResource Text.Label}" FontWeight="Normal" Foreground="{DynamicResource Fg.Secondary}" />
                                    <Grid>
                                        <PasswordBox x:Name="Password" PasswordChanged="Password_PasswordChanged" Tag="empty" Padding="10,0,34,0"
                                                     ui:Ui.Hint="{Binding PasswordHint}" />
                                        <TextBox x:Name="PasswordPlain" Visibility="Collapsed" Padding="10,0,34,0" TextChanged="PasswordPlain_TextChanged" />
                                        <ToggleButton x:Name="ShowPassword" Style="{StaticResource Toggle.Icon}" Width="26" Height="26" FontSize="12" Content="&#xE7B3;"
                                                      HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{ui:Tr Cred.ShowPassword}"
                                                      Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{ui:Tr Cred.PasswordUnreadable}" Foreground="{DynamicResource Status.Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding PasswordUnreadable, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <RadioButton Style="{StaticResource Radio.Option}" GroupName="cred" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Profile}"
                                     Content="{ui:Tr Cred.Mode.Profile}" />
                        <StackPanel Margin="36,4,0,8" Visibility="{Binding IsProfile, Converter={StaticResource Vis}}">
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}" DisplayMemberPath="Display"
                                      Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <TextBlock Text="{ui:Tr Cred.NoProfiles}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Btn.Link}" Content="{ui:Tr Profiles.Add}" Margin="8,0,0,0" Command="{Binding ManageProfilesCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <RadioButton Style="{StaticResource Radio.Option}" GroupName="cred" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Guest}"
                                     Content="{ui:Tr Cred.Mode.Guest}" />
                        <TextBlock Text="{ui:Tr Cred.GuestNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="36,0,0,6"
                                   Visibility="{Binding IsGuest, Converter={StaticResource Vis}}" />

                        <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:Tr Cred.Stored}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="480" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <StackPanel Style="{StaticResource Field}" Margin="0">
                    <TextBlock Text="{ui:Tr Server.Description}" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Test connection (servers only) -->
                    <StackPanel Orientation="Horizontal" DataContext="{Binding ServerFields}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                        <Button Command="{Binding TestCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock x:Name="TestLabel" Text="{ui:Tr Server.Test}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="250"
                                    Visibility="{Binding TestResult, Converter={StaticResource VisIfAny}}">
                            <TextBlock x:Name="TestGlyph" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE783;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Online}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding TestResult}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Secondary}" ToolTip="{Binding TestResult}"
                                       MaxHeight="34" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{ui:Tr Server.Testing}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsTesting, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="220"
                               TextWrapping="Wrap" FontSize="12" Visibility="{Binding ValidationError, Converter={StaticResource VisIfAny}}" />
                    <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr Common.Save}" IsDefault="True" MinWidth="96" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</v:DialogWindow>
