<v:DialogWindow x:Class="RDMan.Views.NodeEditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:RDMan.Infrastructure"
                xmlns:v="clr-namespace:RDMan.Views"
                xmlns:vm="clr-namespace:RDMan.ViewModels"
                xmlns:tvm="clr-namespace:RDMan.ViewModels.Terminal"
                Title="{Binding Title}" Width="800" Height="660" SizeToContent="Manual">
    <v:DialogWindow.Resources>
        <!-- One credentials block for files and for remote desktop (IsDesktop switches the wording/options) -->
        <DataTemplate x:Key="CredentialBlock" DataType="{x:Type vm:CredentialEditorViewModel}">
            <StackPanel>
                <RadioButton Style="{StaticResource Radio.Option}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Inherit}">
                    <StackPanel>
                        <TextBlock x:Name="InheritLabel" Text="{ui:Tr Cred.Mode.Inherit}" />
                        <TextBlock Text="{Binding InheritText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Radio.Option}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=CurrentUser}">
                    <StackPanel>
                        <TextBlock x:Name="WindowsLabel" Text="{ui:Tr Cred.Mode.CurrentUser}" />
                        <TextBlock Text="{ui:Tr Cred.Desktop.WindowsNote}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsDesktop, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Radio.Option}" Content="{ui:Tr Cred.Mode.Custom}"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Custom}" />
                <StackPanel Margin="36,4,8,8" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Cred.Username}" Style="{StaticResource Text.Label}" FontWeight="Normal" Foreground="{DynamicResource Fg.Secondary}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="{ui:Tr Cred.UsernameHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{ui:Tr Cred.Password}" Style="{StaticResource Text.Label}" FontWeight="Normal" Foreground="{DynamicResource Fg.Secondary}" />
                            <PasswordBox Tag="empty" ui:Ui.Hint="{Binding PasswordHint}" PasswordChanged="Password_PasswordChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{ui:Tr Cred.PasswordUnreadable}" Foreground="{DynamicResource Status.Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding PasswordUnreadable, Converter={StaticResource Vis}}" />
                </StackPanel>
                <RadioButton Style="{StaticResource Radio.Option}" Content="{ui:Tr Cred.Mode.Profile}"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Profile}" />
                <StackPanel Margin="36,4,8,8" Visibility="{Binding IsProfile, Converter={StaticResource Vis}}">
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}" DisplayMemberPath="Display"
                              Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <TextBlock Text="{ui:Tr Cred.NoProfiles}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Link}" Content="{ui:Tr Profiles.Add}" Margin="8,0,0,0" Command="{Binding ManageProfilesCommand}" />
                    </StackPanel>
                </StackPanel>
                <RadioButton Style="{StaticResource Radio.Option}" Content="{ui:Tr Cred.Mode.Guest}"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Guest}"
                             Visibility="{Binding IsFiles, Converter={StaticResource Vis}}" />
                <TextBlock Text="{ui:Tr Cred.GuestNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="36,0,0,6"
                           Visibility="{Binding IsGuest, Converter={StaticResource Vis}}" />
                <Grid Margin="8,10,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" Margin="0,0,8,0" />
                        <TextBlock Text="{ui:Tr Cred.Stored}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                    <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="{ui:Tr Cred.ManageProfiles}"
                            Command="{Binding ManageProfilesCommand}" />
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                    <Setter TargetName="InheritLabel" Property="Text" Value="{ui:Tr Cred.Desktop.Mode.Inherit}" />
                    <Setter TargetName="WindowsLabel" Property="Text" Value="{ui:Tr Cred.Desktop.Windows}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </v:DialogWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Section navigation ═══════════ -->
        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Margin="12,0,0,12" KeyboardNavigation.TabNavigation="Once">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Height="36" Margin="0,1">
                                    <Grid>
                                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Accent}"
                                                Visibility="Collapsed" />
                                        <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                        <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SectionChoice}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Fg.Secondary}" Width="18" />
                        <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ═══════════ Section content ═══════════ -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,12">
            <Grid>
                <!-- General -->
                <StackPanel Visibility="{Binding IsGeneralSection, Converter={StaticResource Vis}}">
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Server.Name}" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 ui:Ui.Hint="{ui:Tr Server.NameHint}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Field}" DataContext="{Binding ServerFields}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                        <TextBlock Text="{ui:Tr Server.Address}" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}"
                                 LostFocus="AddressBox_LostFocus" DataObject.Pasting="AddressBox_Pasting"
                                 ui:Ui.Hint="10.0.0.12" />
                        <TextBlock Text="{ui:Tr Server.AddressHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Server.Group}" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" MaxDropDownHeight="320">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupChoice}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="{Binding Depth, Converter={StaticResource Mul}, ConverterParameter=14}" />
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" DataContext="{Binding ServerFields}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                            <TextBlock Text="{ui:Tr Server.Tags}" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="{ui:Tr Server.TagsHint}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="{ui:Tr Server.Color}" Style="{StaticResource Text.Label}" />
                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorChoice}">
                                    <RadioButton Style="{StaticResource Radio.Swatch}" GroupName="color" Background="{Binding Brush}" ToolTip="{Binding Label}"
                                                 BorderBrush="{DynamicResource Line.Strong}" Margin="0,0,4,0" Tag="{Binding Key}"
                                                 Checked="Swatch_Checked" Loaded="Swatch_Loaded" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- What a click opens, only when the server offers both -->
                    <StackPanel Style="{StaticResource Field}" DataContext="{Binding ServerFields}"
                                Visibility="{Binding HasBoth, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{ui:Tr Server.DefaultAction}" Style="{StaticResource Text.Label}" />
                        <Border Background="{DynamicResource Bg.Hover}" CornerRadius="7" Padding="1" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="action"
                                             IsChecked="{Binding DefaultAction, Converter={StaticResource Eq}, ConverterParameter=Files}"
                                             Visibility="{Binding FilesEnabled, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="{ui:Tr Cap.Files}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="action"
                                             IsChecked="{Binding DefaultAction, Converter={StaticResource Eq}, ConverterParameter=Desktop}"
                                             Visibility="{Binding DesktopEnabled, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="{ui:Tr Cap.Desktop}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="action"
                                             IsChecked="{Binding DefaultAction, Converter={StaticResource Eq}, ConverterParameter=Terminal}"
                                             Visibility="{Binding Ssh.Enabled, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="{ui:Tr Cap.Terminal}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Files -->
                <StackPanel Visibility="{Binding IsFilesSection, Converter={StaticResource Vis}}">
                    <StackPanel DataContext="{Binding ServerFields}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Server.Files.Enable}" IsChecked="{Binding FilesEnabled}" Margin="0,4,0,18"
                                  FontWeight="SemiBold" />
                        <StackPanel IsEnabled="{Binding FilesEnabled}">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{ui:Tr Server.Share}" Style="{StaticResource Text.Label}" />
                                    <Grid>
                                        <TextBox Text="{Binding Share, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}"
                                                 ui:Ui.Hint="{ui:Tr Common.Optional}" Padding="10,0,34,0" />
                                        <Button x:Name="ShareMenuButton" Style="{StaticResource Btn.IconSmall}" Content="&#xE70D;" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                ToolTip="{ui:Tr Server.PickShare}" Click="ShareMenuButton_Click"
                                                Visibility="{Binding HasDiscoveredShares, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <TextBlock Text="{ui:Tr Server.ShareHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{ui:Tr Server.StartFolder}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding StartFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="{ui:Tr Common.Optional}" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource Warn.Subtle}" CornerRadius="6" Padding="12,8" Margin="0,-4,0,16"
                                    Visibility="{Binding DuplicateWarning, Converter={StaticResource VisIfAny}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Status.Warn}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding DuplicateWarning}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{ui:Tr Group.CredentialsNote}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,14"
                               Visibility="{Binding IsGroup, Converter={StaticResource Vis}}" />
                    <Border x:Name="FilesCredentials" Style="{StaticResource Panel}"
                            IsEnabled="{Binding ServerFields.FilesEnabled, FallbackValue=True}">
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Cred.Section}" Style="{StaticResource SectionTitle}" FontSize="14" />
                            <!-- -8: the option rows keep their hover padding while their rings line up with the panel title -->
                            <ContentControl Content="{Binding Credentials}" ContentTemplate="{StaticResource CredentialBlock}" Focusable="False" Margin="-8,0,-8,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Remote desktop -->
                <StackPanel Visibility="{Binding IsDesktopSection, Converter={StaticResource Vis}}">
                    <StackPanel DataContext="{Binding ServerFields}" Visibility="{Binding Converter={StaticResource VisIfAny}}">
                        <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Server.Desktop.Enable}" IsChecked="{Binding DesktopEnabled}" Margin="0,4,0,18"
                                  FontWeight="SemiBold" />
                        <StackPanel Style="{StaticResource Field}" IsEnabled="{Binding DesktopEnabled}" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:Tr Server.Desktop.PortLabel}" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding DesktopPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" Width="120" ui:Ui.Hint="3389" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="DesktopCredentials" Style="{StaticResource Panel}" IsEnabled="{Binding ServerFields.DesktopEnabled, FallbackValue=True}">
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Cred.Desktop.Section}" Style="{StaticResource SectionTitle}" FontSize="14" />
                            <ContentControl Content="{Binding DesktopCredentials}" ContentTemplate="{StaticResource CredentialBlock}" Focusable="False" Margin="-8,0,-8,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" IsEnabled="{Binding ServerFields.DesktopEnabled, FallbackValue=True}">
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Rdp.Section}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                            <TextBlock Text="{ui:Tr Rdp.SectionNote}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
                            <ItemsControl ItemsSource="{Binding RdpOptions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RdpOptionRowViewModel}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- dot marks values changed here (not inherited) -->
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0"
                                                         Visibility="{Binding IsOverridden, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Remote Desktop Gateway -->
                    <Border Style="{StaticResource Panel}" IsEnabled="{Binding ServerFields.DesktopEnabled, FallbackValue=True}">
                        <StackPanel DataContext="{Binding Gateway}">
                            <TextBlock Text="{ui:Tr Gateway.Section}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                            <TextBlock Text="{ui:Tr Gateway.SectionNote}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0"
                                             Visibility="{Binding IsOverridden, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{ui:Tr Gateway.Use}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="{ui:Tr Gateway.Use}" />
                            </Grid>
                            <StackPanel Visibility="{Binding IsGateway, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Gateway.Host}" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="rdgw.empresa.com"
                                                 AutomationProperties.Name="{ui:Tr Gateway.Host}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{ui:Tr Gateway.Logon}" Style="{StaticResource Text.Label}" />
                                        <ComboBox ItemsSource="{Binding Logons}" SelectedItem="{Binding SelectedLogon}" DisplayMemberPath="Label"
                                                  AutomationProperties.Name="{ui:Tr Gateway.Logon}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Visibility="{Binding IsCustomLogon, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Gateway.User}" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="DOMINIO\usuario"
                                                 AutomationProperties.Name="{ui:Tr Gateway.User}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{ui:Tr Gateway.Password}" Style="{StaticResource Text.Label}" />
                                        <PasswordBox PasswordChanged="GatewayPassword_PasswordChanged" AutomationProperties.Name="{ui:Tr Gateway.Password}" />
                                        <TextBlock Text="{ui:Tr Gateway.PasswordKept}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasStoredPassword, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SSH terminal -->
                <!-- Visibility binds on the outer panel: on the element that sets DataContext="{Binding Ssh}" it would resolve against Ssh, fail, and leave the section always visible -->
                <StackPanel Visibility="{Binding IsTerminalSection, Converter={StaticResource Vis}}">
                    <StackPanel DataContext="{Binding Ssh}">
                        <StackPanel Visibility="{Binding IsServer, Converter={StaticResource Vis}}">
                            <CheckBox Style="{StaticResource Switch}" Content="{ui:Tr Term.Editor.Enable}" IsChecked="{Binding Enabled}" Margin="0,4,0,18" FontWeight="SemiBold" />
                            <StackPanel IsEnabled="{Binding Enabled}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr Term.Editor.Port}" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="22"
                                                 AutomationProperties.Name="{ui:Tr Term.Editor.Port}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Bottom" Margin="0,0,0,7" IsChecked="{Binding UseSshConfig}">
                                        <TextBlock Text="{ui:Tr Term.Editor.UseConfig}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </Grid>
                                <!-- What "ssh <address>" resolves to, live -->
                                <Border Background="{DynamicResource Bg.Hover}" CornerRadius="6" Padding="12,9" Margin="0,0,0,18"
                                        Visibility="{Binding ConfigPreview, Converter={StaticResource VisIfAny}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PreviewIcon" Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Fg.Tertiary}"
                                                   Margin="0,1,10,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConfigPreview}" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Secondary}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{ui:Tr Term.Editor.GroupNote}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Visibility="{Binding IsServer, Converter={StaticResource Vis}, ConverterParameter=invert}" />

                        <!-- Sign-in -->
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{ui:Tr Term.Editor.Auth.Section}" Style="{StaticResource SectionTitle}" FontSize="14" />
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="{ui:Tr Term.Prompt.User}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="{Binding UsernameHint}"
                                             AutomationProperties.Name="{ui:Tr Term.Prompt.User}" />
                                </StackPanel>
                                <StackPanel Margin="-8,0,-8,0">
                                    <RadioButton Style="{StaticResource Radio.Option}" IsChecked="{Binding IsInherit}">
                                        <StackPanel>
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.Inherit}" />
                                            <TextBlock Text="{Binding InheritText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Radio.Option}" IsChecked="{Binding IsAuto}">
                                        <StackPanel>
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.Auto}" />
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.AutoNote}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Radio.Option}" IsChecked="{Binding IsKey}">
                                        <StackPanel>
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.Key}" />
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.KeyNote}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <Grid Margin="36,4,8,8" Visibility="{Binding IsKey, Converter={StaticResource Vis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}" Visibility="{Binding HasKeys, Converter={StaticResource Vis}}"
                                                  AutomationProperties.Name="{ui:Tr Term.Editor.Auth.Key}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type tvm:KeyChoice}">
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Mono}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{ui:Tr Term.Editor.Key.None}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                                   Visibility="{Binding HasKeys, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ImportKeyCommand}" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="{ui:Tr Term.Editor.Key.Import}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <RadioButton Style="{StaticResource Radio.Option}" Content="{ui:Tr Term.Editor.Auth.Password}" IsChecked="{Binding IsPassword}" />
                                    <StackPanel Margin="36,4,8,8" Visibility="{Binding IsPassword, Converter={StaticResource Vis}}">
                                        <PasswordBox x:Name="SshPassword" Tag="empty" PasswordChanged="SshPassword_PasswordChanged" Width="260" HorizontalAlignment="Left"
                                                     AutomationProperties.Name="{ui:Tr Term.Prompt.Password}" />
                                        <TextBlock Text="{ui:Tr Gateway.PasswordKept}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                                   Visibility="{Binding HasStoredPassword, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                    <RadioButton Style="{StaticResource Radio.Option}" IsChecked="{Binding IsAgent}">
                                        <StackPanel>
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.Agent}" />
                                            <TextBlock Text="{ui:Tr Term.Editor.Auth.AgentNote}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" Margin="0,0,8,0" />
                                    <TextBlock Text="{ui:Tr Term.Editor.Auth.Stored}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="460" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Port forwarding (servers) -->
                        <Border Style="{StaticResource Panel}" Visibility="{Binding IsServer, Converter={StaticResource Vis}}" IsEnabled="{Binding Enabled}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{ui:Tr Term.Editor.Forward.Section}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                                    <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Command="{Binding AddForwardCommand}" Content="{ui:Tr Term.Editor.Forward.Add}" />
                                </Grid>
                                <TextBlock Text="{ui:Tr Term.Editor.Forward.Note}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Forwards}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:ForwardRowViewModel}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{x:Static tvm:ForwardRowViewModel.Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label"
                                                          AutomationProperties.Name="{ui:Tr Term.Editor.Forward.Kind}" />
                                                <TextBox Grid.Column="2" Text="{Binding BindPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}"
                                                         ui:Ui.Hint="{ui:Tr Term.Editor.Forward.PortHint}" AutomationProperties.Name="{ui:Tr Term.Editor.Forward.PortHint}" />
                                                <TextBlock Grid.Column="3" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}"
                                                           HorizontalAlignment="Center" Visibility="{Binding NeedsTarget, Converter={StaticResource Vis}}" />
                                                <TextBox Grid.Column="4" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}"
                                                         ui:Ui.Hint="{ui:Tr Term.Editor.Forward.TargetHint}" Visibility="{Binding NeedsTarget, Converter={StaticResource Vis}}"
                                                         AutomationProperties.Name="{ui:Tr Term.Editor.Forward.TargetHint}" />
                                                <CheckBox Grid.Column="6" Content="{ui:Tr Term.Editor.Forward.Auto}" IsChecked="{Binding AutoStart}" VerticalAlignment="Center" />
                                                <Button Grid.Column="7" Style="{StaticResource Btn.IconSmall}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="{ui:Tr Common.Delete}"
                                                        Command="{Binding DataContext.RemoveForwardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Terminal options -->
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{ui:Tr Term.Editor.Options.Section}" Style="{StaticResource Text.Subtitle}" FontSize="14" />
                                <TextBlock Text="{ui:Tr Rdp.SectionNote}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:SshOptionRowViewModel}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="250" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0"
                                                             Visibility="{Binding IsOverridden, Converter={StaticResource Vis}}" />
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                                                          AutomationProperties.Name="{Binding Label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Style="{StaticResource Field}" Margin="0,8,0,16">
                                    <TextBlock Text="{ui:Tr Term.Editor.ProxyJump}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ProxyJump, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="{Binding ProxyJumpHint}"
                                             AutomationProperties.Name="{ui:Tr Term.Editor.ProxyJump}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}" Margin="0">
                                    <TextBlock Text="{ui:Tr Term.Editor.Startup}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding StartupCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" ui:Ui.Hint="{Binding StartupCommandHint}"
                                             AutomationProperties.Name="{ui:Tr Term.Editor.Startup}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Notes -->
                <StackPanel Visibility="{Binding IsNotesSection, Converter={StaticResource Vis}}">
                    <TextBlock Text="{ui:Tr Server.Description}" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" MinHeight="220" MaxHeight="460" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════ Footer ═══════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Dialog.Footer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- "Test connection" results: one row per enabled protocol, badge first, so it's clear what was tested and what failed -->
                <ItemsControl Grid.ColumnSpan="2" DataContext="{Binding ServerFields}" ItemsSource="{Binding TestResults}" Focusable="False"
                              AutomationProperties.LiveSetting="Polite">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <!-- rows carry 3px above/below: -3 keeps the footer's 14px top inset, 9 leaves 12px above the buttons -->
                            <Setter Property="Margin" Value="0,-3,0,9" />
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectionCheck}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Badge" Style="{StaticResource CapBadge.Smb}" Width="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Protocol}" />
                                </Border>
                                <Grid Grid.Column="1" Width="14" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <!-- Running: a turning arc (a circle doesn't wobble when rotated, an icon glyph does) -->
                                    <Ellipse x:Name="Spinner" Width="11" Height="11" Stroke="{DynamicResource Fg.Tertiary}" StrokeThickness="1.5"
                                             StrokeDashArray="4 2.4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="Text" Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" LineHeight="16"
                                           Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Top" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Protocol}" Value="RDP">
                                    <Setter TargetName="Badge" Property="Style" Value="{StaticResource CapBadge.Rdp}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Protocol}" Value="SSH">
                                    <Setter TargetName="Badge" Property="Style" Value="{StaticResource CapBadge.Ssh}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Running">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Spin">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Spin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Ok">
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Online}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Fg.Tertiary}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" DataContext="{Binding ServerFields}"
                        Visibility="{Binding Converter={StaticResource VisIfAny}}" Command="{Binding TestCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource Not}}" ToolTip="{ui:Tr Server.TestTip}" AutomationProperties.Name="{ui:Tr Server.Test}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{ui:Tr Server.Test}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                            <Setter Property="Text" Value="{ui:Tr Server.Testing}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="240"
                               TextWrapping="Wrap" FontSize="12" Visibility="{Binding ValidationError, Converter={StaticResource VisIfAny}}" />
                    <Button Content="{ui:Tr Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{ui:Tr Common.Save}" IsDefault="True" MinWidth="96" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</v:DialogWindow>
