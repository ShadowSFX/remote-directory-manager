<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:RDMan.Views"
                    xmlns:ui="clr-namespace:RDMan.Infrastructure">

    <!-- Modal dialogs: custom header, native shadow + rounded corners kept by a 1px glass frame. -->
    <Style x:Key="Dialog" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Bg.Content}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line.Strong}" BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource Text.Subtitle}" Margin="24,4,56,0" VerticalAlignment="Center" />
                            <Button Style="{DynamicResource Btn.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Height="36" Width="46" WindowChrome.IsHitTestVisibleInChrome="True" IsCancel="False"
                                    Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="{ui:Tr Common.Close}" />
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dialog.Body" TargetType="StackPanel">
        <Setter Property="Margin" Value="24,4,24,20" />
    </Style>

    <Style x:Key="Dialog.Footer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,14" />
    </Style>

    <Style x:Key="Field" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
</ResourceDictionary>
