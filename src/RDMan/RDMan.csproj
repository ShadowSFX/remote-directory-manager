<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used to host the RDP ActiveX control (RoyalApps RdpControl) inside WindowsFormsHost -->
    <UseWindowsForms>true</UseWindowsForms>
    <MsRdpExComInterop>Legacy</MsRdpExComInterop>
    <MsRdpExGeneratedWinForms>false</MsRdpExGeneratedWinForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RDMan</AssemblyName>
    <RootNamespace>RDMan</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rdman.ico</ApplicationIcon>
    <AssemblyTitle>Remote Directory Manager</AssemblyTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Portable single-file publish -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- WFO0003 asks WinForms apps to drop DPI settings from the manifest; this is a WPF app, where the
         manifest (PerMonitorV2) is the correct mechanism and also applies to the hosted RDP control. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDMan.Core\RDMan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="RoyalApps.Community.Rdp.WinForms" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF type names unambiguous: WinForms/Drawing types are referenced fully qualified where needed -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\rdman.ico" />
    <Resource Include="Assets\rdman.png" />
  </ItemGroup>

</Project>
