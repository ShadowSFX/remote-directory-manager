<Window x:Class="RDMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RDMan.Infrastructure"
        xmlns:v="clr-namespace:RDMan.Views"
        xmlns:vm="clr-namespace:RDMan.ViewModels"
        xmlns:svc="clr-namespace:RDMan.Services"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/RDMan;component/Assets/rdman.ico"
        Width="1320" Height="820" MinWidth="760" MinHeight="460"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{StaticResource Font.UI}" FontSize="{StaticResource Size.Body}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="F3" Command="{Binding ToggleSplitCommand}" />
        <KeyBinding Key="F6" Command="{Binding FocusOtherPaneCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewServerCommand}" />
        <KeyBinding Key="G" Modifiers="Control+Shift" Command="{Binding NewGroupCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Title bar ═══════════ -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/RDMan;component/Assets/rdman.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Remote Directory Manager" Margin="10,0,0,0" FontFamily="{StaticResource Font.Small}" FontSize="12"
                           Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search / command palette entry -->
            <Button Grid.Column="2" x:Name="SearchButton" Width="420" Height="30" Padding="10,0" WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding OpenPaletteCommand}" HorizontalContentAlignment="Stretch"
                    Background="{DynamicResource Bg.Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Style="{StaticResource Btn.Base}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Fg.Tertiary}" />
                        <TextBlock Text="{ui:Tr Title.Search}" Margin="10,0,0,0" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource Kbd}" HorizontalAlignment="Right">
                        <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource Fg.Tertiary}" />
                    </Border>
                </Grid>
            </Button>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button Style="{StaticResource Btn.IconToggle}" Content="&#xE89F;" ui:Ui.IsOn="{Binding IsSplit}"
                        Command="{Binding ToggleSplitCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{ui:Tr Title.Split}" />
                <Button x:Name="MenuButton" Style="{StaticResource Btn.Icon}" Content="&#xE712;" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{ui:Tr Title.Menu}" Click="MenuButton_Click" />
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE713;" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{ui:Tr Title.Settings}" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinButton" Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{ui:Tr Title.Minimize}" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="CloseButton" Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{ui:Tr Title.Close}" WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <!-- ═══════════ Body ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="272" MinWidth="200" MaxWidth="560" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <v:SidebarView Grid.Column="0" />

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          DragCompleted="SidebarSplitter_DragCompleted" />

            <!-- Content surface: a single rounded sheet over the window backdrop -->
            <Border Grid.Column="2" Background="{DynamicResource Bg.Content}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0" ClipToBounds="True">
                <Grid x:Name="PanesGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition x:Name="PaneSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="RightPaneColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <v:PaneView Grid.Column="0" DataContext="{Binding Left}" />
                    <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Style="{StaticResource Splitter}" HorizontalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Visibility="{Binding IsSplit, Converter={StaticResource Vis}}" Background="{DynamicResource Line}" />
                    <v:PaneView Grid.Column="2" DataContext="{Binding Right}" Visibility="{Binding DataContext.IsSplit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Status bar ═══════════ -->
        <Grid Grid.Row="2" Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding ActiveTab}">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Caption}" Margin="16,0,0,0"
                           Visibility="{Binding SelectionText, Converter={StaticResource VisIfAny}}" />
                <TextBlock Text="{Binding ConnectedAs}" Style="{StaticResource Text.Caption}" Margin="16,0,0,0"
                           Visibility="{Binding ConnectedAs, Converter={StaticResource VisIfAny}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Update ready chip -->
                <Border Background="{DynamicResource Accent.Subtle}" CornerRadius="4" Padding="8,0,2,0" Height="22" Margin="0,0,12,0"
                        Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Accent.Text}" />
                        <TextBlock Margin="6,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Accent.Text}"
                                   Text="{Binding UpdateReadyText}" ToolTip="{ui:Tr Update.ReadyBody}" />
                        <Button Style="{StaticResource Btn.Base}" Height="18" Padding="8,0" FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource Fg.OnAccent}" Background="{DynamicResource Accent}" Content="{ui:Tr Update.Restart}"
                                Command="{Binding RestartToUpdateCommand}" ui:Ui.CornerRadius="3" />
                        <Button Style="{StaticResource Btn.IconSmall}" Width="18" Height="18" Content="&#xE711;" FontSize="8" Margin="2,0,0,0"
                                Command="{Binding DismissUpdateBannerCommand}" ToolTip="{ui:Tr Update.Later}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding DataLocationText}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Grid>

        <!-- ═══════════ Toasts ═══════════ -->
        <ItemsControl Grid.Row="1" Grid.RowSpan="2" ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,40" Width="380" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:ToastViewModel}">
                    <Border Background="{DynamicResource Bg.Toast}" CornerRadius="8" Padding="14,10,8,10" Margin="0,8,0,0" BorderThickness="1"
                            BorderBrush="#22FFFFFF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="14" Foreground="#FFB9C2FF"
                                       VerticalAlignment="Top" Margin="0,2,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#FFF1F3F8" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19" />
                            <Button Grid.Column="2" Content="{Binding ActionText}" Style="{StaticResource Btn.Base}" Foreground="#FFB9C2FF" FontWeight="SemiBold"
                                    Height="28" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasAction, Converter={StaticResource Vis}}"
                                    Command="{Binding DataContext.Toasts.InvokeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Style="{StaticResource Btn.IconSmall}" Content="&#xE711;" Foreground="#FFB4BAC6" VerticalAlignment="Top"
                                    Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FF5BD07D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFF7B78" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════ Command palette ═══════════ -->
        <Grid x:Name="PaletteLayer" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource Bg.Scrim}"
              Visibility="{Binding Palette.IsOpen, Converter={StaticResource Vis}}" MouseDown="PaletteScrim_MouseDown">
            <Border x:Name="PaletteCard" Width="640" VerticalAlignment="Top" Margin="0,84,0,0" Background="{DynamicResource Bg.Popup}"
                    BorderBrush="{DynamicResource Line.Popup}" BorderThickness="1" CornerRadius="10" DataContext="{Binding Palette}"
                    MouseDown="PaletteCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,0">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Foreground="{DynamicResource Fg.Tertiary}" />
                        <TextBox x:Name="PaletteInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Height="56"
                                 Background="Transparent" BorderThickness="0" Padding="18,0,0,0" ui:Ui.Hint="{ui:Tr Palette.Placeholder}"
                                 PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" MaxHeight="420">
                        <Grid>
                            <ListBox x:Name="PaletteList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent"
                                     BorderThickness="0" Padding="6" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseUp="PaletteList_MouseUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaletteResult}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" Height="28" CornerRadius="2" Margin="0,0,12,0"
                                                    Background="{Binding Server.ColorBrush, Converter={StaticResource BrushOr}, ConverterParameter=Line.Strong}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Server.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding GroupPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasGroup, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" DataContext="{Binding Server}">
                                                <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Mono}" Margin="0,0,10,0" />
                                                <Ellipse Style="{StaticResource StatusDot}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{ui:Tr Palette.NoResults}" Style="{StaticResource Text.Secondary}" Margin="20,18"
                                       Visibility="{Binding HasNoResults, Converter={StaticResource Vis}}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                        <TextBlock Text="{ui:Tr Palette.Hint}" Style="{StaticResource Text.Caption}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
